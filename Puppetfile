# Forge modules for this environment. r10k installs them into ./modules
# on the Puppet server every time it deploys.
#
# The starter code only uses Puppet's built-in resource types, so nothing
# is required yet. Add modules like this:
#
#   mod 'puppetlabs-stdlib', '9.6.0'
#   mod 'puppet-chrony',     '3.0.0'
#
# Or straight from Git:
#
#   mod 'mymodule',
#     git: 'https://github.com/example/puppet-mymodule.git',
#     ref: 'main'
